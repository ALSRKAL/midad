# Midad — environment template.
#
#   cp .env.example .env.local
#
# Every value below is validated by src/env.ts with Zod at boot. If a required variable is
# missing or malformed the application refuses to start and prints the exact variable name.
# Required = no default in src/env.ts. Optional = the feature it powers is disabled when absent.
#
# Local defaults match `docker-compose.yml` (pnpm dev:up), so a working .env.local can be
# created by copying this file without editing anything except the secrets marked CHANGE ME.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# REQUIRED. development | test | production. Production adds extra boot guards.
NODE_ENV=development
# REQUIRED. fatal|error|warn|info|debug|trace — pino log level.
LOG_LEVEL=info
# REQUIRED. Public origin of the app. Used for absolute links (emails, sitemap, og:url).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database & cache  (docker compose service: postgres / redis)
# ---------------------------------------------------------------------------
# REQUIRED. PostgreSQL connection string. Port 5433 because compose publishes it there to avoid
# clashing with a locally installed Postgres; keep the two in sync if you change it.
DATABASE_URL=postgresql://midad:midad@localhost:5433/midad
# REQUIRED. Redis connection string (rate limiting + BullMQ queues).
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Object storage  (docker compose service: storage — S3-compatible)
# ---------------------------------------------------------------------------
# REQUIRED. S3 API endpoint. Locally MinIO; in production an S3-compatible endpoint.
S3_ENDPOINT=http://localhost:9000
# REQUIRED. Any non-empty string for MinIO; the real region for AWS S3.
S3_REGION=us-east-1
# REQUIRED. Credentials for the storage endpoint.
S3_ACCESS_KEY_ID=midad
S3_SECRET_ACCESS_KEY=midad-dev-secret
# REQUIRED. Public bucket (course covers, avatars) — readable anonymously.
S3_BUCKET_PUBLIC=midad-public
# REQUIRED. Private bucket (videos, attachments, invoices) — served only via signed URLs (BR-20).
S3_BUCKET_PRIVATE=midad-media
# REQUIRED. true for MinIO and most self-hosted gateways; false for AWS S3 virtual-host style.
S3_FORCE_PATH_STYLE=true
# OPTIONAL. Lifetime of signed content URLs in seconds. BR-20 requires 900 (15 minutes).
S3_SIGNED_URL_TTL_SEC=900

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED — CHANGE ME. Session/token signing secret. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=change-me-with-openssl-rand-base64-48-characters-minimum
# OPTIONAL. Google OAuth. When both are set the "Continue with Google" button appears;
# when absent the button is not rendered at all (P02-T03).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED. From address for verification and reset emails.
AUTH_EMAIL_FROM=no-reply@midad.example
# OPTIONAL. Authentication rate limit: window in seconds and max attempts per IP (defaults 60/5).
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Email  (docker compose service: mail — Mailpit locally, Resend in production)
# ---------------------------------------------------------------------------
# REQUIRED. SMTP host. Mailpit locally; smtp.resend.com in production.
SMTP_HOST=localhost
# REQUIRED. SMTP port. Mailpit listens on 1025 and shows every message at http://localhost:8025.
SMTP_PORT=1025
# OPTIONAL. SMTP credentials; Mailpit accepts any value and does not require them.
SMTP_USER=
SMTP_PASSWORD=
# REQUIRED. true for implicit TLS (port 465). Mailpit and Resend's submission port use false.
SMTP_SECURE=false
# OPTIONAL. When set, Resend is used instead of SMTP.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Payments  (Stripe test mode; docker compose profile: stripe)
# ---------------------------------------------------------------------------
# OPTIONAL at boot, REQUIRED for checkout. Without them the catalog works and the cart explains
# that payment is unavailable — no dead buttons (see the product requirements).
# Test cards: 4242 4242 4242 4242 (success) · 4000 0000 0000 0002 (declined) · 4000 0027 6000 3184 (3DS)
STRIPE_SECRET_KEY=
# OPTIONAL. From `pnpm dev:stripe` (the CLI prints it) or the Stripe dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=
# OPTIONAL. Publishable key — this one is safe in the browser (pk_test_…).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# TEST-ONLY. Loopback gateway used by the E2E suite; non-loopback hosts are refused in production.
# STRIPE_API_BASE=http://127.0.0.1:3200

# ---------------------------------------------------------------------------
# Video pipeline
# ---------------------------------------------------------------------------
# REQUIRED. hls = ffmpeg in the worker (default) | mux = hosted service (ADR-0005).
VIDEO_PROVIDER=hls
# OPTIONAL. Required only when VIDEO_PROVIDER=mux.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# REQUIRED. ffmpeg binary used by the worker.
FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# REQUIRED. Parallel jobs per worker process (email, video, certificate, invoice).
WORKER_CONCURRENCY=4
# REQUIRED. Test-only clock offset in milliseconds (ADR-0007). Must be 0 in production.
CLOCK_OFFSET_MS=0

# ---------------------------------------------------------------------------
# Product defaults  (seeded into PlatformSetting; an admin can change them later)
# ---------------------------------------------------------------------------
# REQUIRED. SAR | USD.
DEFAULT_CURRENCY=SAR
# REQUIRED. Instructor share in basis points (BR-11): 7000 = 70%.
PLATFORM_COMMISSION_BPS=7000
# REQUIRED. VAT in basis points (BR-06): 1500 = 15%.
VAT_BPS=1500
# REQUIRED. When true, every visitor except signed-in admins sees the maintenance page.
MAINTENANCE_MODE=false
# REQUIRED. Safety switch: the seeder refuses to run against a production database unless true.
ALLOW_SEED_IN_PRODUCTION=false

# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle — never put a secret here)
# ---------------------------------------------------------------------------
# REQUIRED. Canonical origin used by next-intl, canonical URLs and absolute metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# REQUIRED. ar | en.
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# REQUIRED. SAR | USD.
NEXT_PUBLIC_DEFAULT_CURRENCY=SAR

# ---------------------------------------------------------------------------
# Internal tools
# ---------------------------------------------------------------------------
# OPTIONAL. Enables the design-system catalogue in a *production* build so the screenshot and axe
# audits can run without the dev HMR socket. Never set this on a real deployment.
ENABLE_DESIGN_SYSTEM=0
