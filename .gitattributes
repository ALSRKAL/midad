# Normalize line endings for all text files
* text=auto eol=lf

# Explicit types for tooling
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets must never be converted
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.pdf binary
*.lottie binary
*.zip binary