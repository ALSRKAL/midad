{
  "name": "midad",
  "version": "1.1.1",
  "private": true,
  "description": "Midad — a bilingual (Arabic-first) learning platform and course marketplace",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky",
    "dev": "next dev",
    "dev:up": "docker compose up -d --wait postgres redis storage mail && docker compose run --rm --no-deps storage-init",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v --remove-orphans",
    "dev:logs": "docker compose logs -f --tail=100",
    "dev:stripe": "docker compose --profile stripe up -d --wait stripe",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "secrets:scan": "sh scripts/gitleaks-staged.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:verify": "sh scripts/db-verify.sh",
    "db:seed": "node --env-file=.env.local --import tsx prisma/seed/seed.ts",
    "worker": "node --env-file=.env.local --import tsx worker/index.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:journeys": "playwright test tests/journeys",
    "test:chaos": "playwright test --project=chaos",
    "test:load": "k6 run tests/load/browse.js",
    "test:load:stress": "k6 run tests/load/stress.js",
    "test:load:spike": "k6 run tests/load/spike.js",
    "test:load:soak": "k6 run tests/load/soak.js",
    "worker:bundle": "esbuild worker/index.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=worker-dist/index.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm test && pnpm build && pnpm test:e2e",
    "clean": "rm -rf .next node_modules/.cache"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.956.0",
    "@aws-sdk/s3-request-presigner": "3.956.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lottiefiles/dotlottie-react": "0.17.14",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/extension-code-block-lowlight": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@vidstack/react": "1.15.7",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hls.js": "1.7.4",
    "ioredis": "6.0.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nodemailer": "10.4.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "17.2.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
